{
  "expo": {
    "name": "Far-Reach",
    "slug": "Far-Reach",
    "owner": "webd2killer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "kisanmitra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22C55E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan crops for analysis.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for farmer voice assistance in Indian regional languages.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to process your farming queries."
      }
    },
    "android": {
      "package": "com.farreach.farmerapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22C55E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Far-Reach to access your camera."
        }
      ],
      "expo-image-picker",
      "expo-av",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow Far-Reach to use the microphone for voice chatting.",
          "speechRecognitionPermission": "Allow Far-Reach to securely recognize your speech."
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}